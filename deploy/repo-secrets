#!/usr/bin/env bash
# Runs on YOUR computer (not the server): uploads GitHub Actions secrets to a repo from local files, so a new repo
# doesn't need them copied in by hand.
#
#   deploy/repo-secrets OWNER/REPO              the deploy secrets: TS_OAUTH_CLIENT_ID, TS_OAUTH_SECRET
#   deploy/repo-secrets OWNER/REPO NAME...      any other secrets
#   deploy/repo-secrets OWNER/REPO --check      show which of them the repo already has (names and dates only)
#
# Each secret is one file named after it in $SECRETS_DIR (default ~/.secrets), holding just the value:
#   ~/.secrets/TS_OAUTH_CLIENT_ID
#   ~/.secrets/TS_OAUTH_SECRET
# Values go to `gh secret set` on stdin (never on the command line or in output); a trailing newline is dropped.
# Needs the GitHub CLI logged in with access to the repo (`gh auth status`).
set -euo pipefail
die() { echo "repo-secrets: $*" >&2; exit 1; }

DIR=${SECRETS_DIR:-$HOME/.secrets}
REPO=${1:-}
[[ $REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "usage: repo-secrets OWNER/REPO [NAME... | --check]"
shift
command -v gh >/dev/null || die "the GitHub CLI (gh) is not installed"

CHECK=false
NAMES=()
for a in "$@"; do
  if [ "$a" = --check ]; then CHECK=true; else NAMES+=("$a"); fi
done
[ ${#NAMES[@]} -gt 0 ] || NAMES=(TS_OAUTH_CLIENT_ID TS_OAUTH_SECRET)

if $CHECK; then
  have=$(gh secret list -R "$REPO" --json name,updatedAt --jq '.[] | "\(.name) \(.updatedAt)"')
  for n in "${NAMES[@]}"; do
    line=$(grep -E "^$n " <<<"$have" || true)
    if [ -n "$line" ]; then echo "set      $line"; else echo "missing  $n"; fi
  done
  exit 0
fi

# Warn (don't fail) if the secrets are readable by other users of this computer.
if [ -n "$(find "$DIR" -maxdepth 1 -perm -o=r -print -quit 2>/dev/null)" ]; then
  echo "repo-secrets: note: $DIR is readable by other users; consider: chmod 700 $DIR && chmod 600 $DIR/*" >&2
fi

for n in "${NAMES[@]}"; do
  [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad secret name '$n'"
  f="$DIR/$n"
  [ -s "$f" ] || die "$f is missing or empty"
done
for n in "${NAMES[@]}"; do
  printf '%s' "$(cat "$DIR/$n")" | gh secret set "$n" -R "$REPO" >/dev/null
  echo "set $n on $REPO"
done
