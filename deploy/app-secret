#!/usr/bin/env bash
# Root helper behind the secrets web UI (deploy/secrets-ui). The UI's user may run only this as root:
#   app-secret list               node apps, each with the key names it has (never values): "NAME<TAB>KEY KEY ..."
#   app-secret set NAME KEY       value on stdin: one line, at most 8 KiB
#   app-secret unset NAME KEY
#   app-secret restart NAME
# It only touches /etc/apps/secrets/NAME.env of an existing node app (root-only; systemd reads it before starting
# app@NAME, see setup-secrets.sh) and only restarts app@NAME.
set -euo pipefail
umask 077
die() { echo "app-secret: $*" >&2; exit 1; }
DIR=/etc/apps/secrets
mkdir -p "$DIR" && chmod 700 "$DIR"

is_app() { [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] && [ -f "/etc/apps/$1.port" ]; }
keys() { [ -f "$DIR/$1.env" ] && sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$DIR/$1.env" | sort -u | tr '\n' ' ' || true; }

# Replaces KEY's line in NAME's file with $3 (empty: removes it). Atomic.
rewrite() {
  local f=$DIR/$1.env tmp
  tmp=$(mktemp "$DIR/.$1.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  [ -f "$f" ] && { grep -v "^$2=" "$f" > "$tmp" || true; }
  [ -z "$3" ] || printf '%s\n' "$3" >> "$tmp"
  mv -f "$tmp" "$f"
  trap - EXIT
}

CMD=${1:-} NAME=${2:-} KEY=${3:-}
case $CMD in
  list)
    for p in /etc/apps/*.port; do
      [ -e "$p" ] || continue
      n=$(basename "$p" .port)
      is_app "$n" && printf '%s\t%s\n' "$n" "$(keys "$n")"
    done
    ;;
  set|unset)
    is_app "$NAME" || die "no node app '$NAME'"
    [[ $KEY =~ ^[A-Za-z_][A-Za-z0-9_]{0,127}$ ]] || die "bad key '$KEY' (letters, digits, underscore)"
    [ "$KEY" != PORT ] || die "PORT is assigned by app-deploy"
    if [ "$CMD" = unset ]; then rewrite "$NAME" "$KEY" ""; echo "removed $KEY from $NAME"; exit; fi
    tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
    head -c 8193 > "$tmp"
    size=$(stat -c %s "$tmp")
    [ "$size" -gt 0 ] || die "empty value"
    [ "$size" -le 8192 ] || die "value longer than 8 KiB"
    [ "$(LC_ALL=C tr -d '\000\n\r' < "$tmp" | wc -c)" = "$size" ] || die "value must be a single line"
    v=$(cat "$tmp"); rm -f "$tmp"; trap - EXIT
    # systemd EnvironmentFile syntax: inside double quotes, backslash escapes \ " $ and `.
    v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\$/\\\$}; v=${v//\`/\\\`}
    rewrite "$NAME" "$KEY" "$KEY=\"$v\""
    echo "set $KEY for $NAME"
    ;;
  restart)
    is_app "$NAME" || die "no node app '$NAME'"
    systemctl restart "app@$NAME"
    echo "restarted app@$NAME"
    ;;
  *) die "usage: app-secret list | set NAME KEY (value on stdin) | unset NAME KEY | restart NAME" ;;
esac
