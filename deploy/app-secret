#!/usr/bin/env bash
# Root helper behind the secrets page (deploy/secrets-ui). The page's user may run only this as root:
#   app-secret apps           names of the node apps
#   app-secret get NAME       NAME's secrets as KEY=value lines (raw values)
#   app-secret put NAME       replaces all of NAME's secrets with the KEY=value lines on stdin
#   app-secret restart NAME
# It only touches /etc/apps/secrets/NAME.env of an existing node app (root-only; systemd reads it before starting
# app@NAME, see setup-secrets.sh) and only restarts app@NAME.
set -euo pipefail
umask 077
die() { echo "app-secret: $*" >&2; exit 1; }
DIR=/etc/apps/secrets
mkdir -p "$DIR" && chmod 700 "$DIR"

is_app() { [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] && [ -f "/etc/apps/$1.port" ]; }

CMD=${1:-} NAME=${2:-}
case $CMD in get|put|restart) is_app "$NAME" || die "no node app '$NAME'" ;; esac
case $CMD in
  apps)
    for p in /etc/apps/*.port; do
      n=$(basename "$p" .port)
      if [ -e "$p" ] && is_app "$n"; then echo "$n"; fi
    done
    ;;
  get)
    # Stored as KEY="value" with \ " $ and ` backslash-escaped (systemd EnvironmentFile syntax); print raw values.
    [ ! -f "$DIR/$NAME.env" ] || sed -nE '/^[A-Za-z_][A-Za-z0-9_]*="/{s/^([^=]+)="(.*)"$/\1=\2/;s/\\(.)/\1/g;p}' "$DIR/$NAME.env"
    ;;
  put)
    in=$(mktemp) out=$(mktemp "$DIR/.$NAME.XXXXXX")
    trap 'rm -f "$in" "$out"' EXIT
    head -c 262145 > "$in"
    size=$(stat -c %s "$in")
    [ "$size" -le 262144 ] || die "too much input"
    [ "$(LC_ALL=C tr -d '\000\r' < "$in" | wc -c)" = "$size" ] || die "values must be single lines"
    declare -A seen=()
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      [[ $line == *=* ]] || die "bad line (no '=')"
      k=${line%%=*} v=${line#*=}
      [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]{0,127}$ ]] || die "bad key '$k' (letters, digits, underscore)"
      [ "$k" != PORT ] || die "PORT is assigned by app-deploy"
      [ -z "${seen[$k]:-}" ] || die "duplicate key '$k'"
      [ "${#v}" -le 8192 ] || die "value of $k is longer than 8 KiB"
      seen[$k]=1
      v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\$/\\\$}; v=${v//\`/\\\`}
      printf '%s="%s"\n' "$k" "$v" >> "$out"
    done < "$in"
    mv -f "$out" "$DIR/$NAME.env"
    echo "saved ${#seen[@]} secret(s) for $NAME"
    ;;
  restart)
    systemctl restart "app@$NAME"
    echo "restarted app@$NAME"
    ;;
  *) die "usage: app-secret apps | get NAME | put NAME (KEY=value lines on stdin) | restart NAME" ;;
esac
